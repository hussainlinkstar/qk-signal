# Frontend Production Environment Template
#
# Only variables consumed by the Next.js frontend (BFF proxy, SSR, NEXT_PUBLIC_*).
# Backend/worker/infra variables live in the root .env.example.
#
# ┌────────────────────────────────────┬──────────┬─────────────────────────┐
# │ Variable                           │ Required │ Consumed by             │
# ├────────────────────────────────────┼──────────┼─────────────────────────┤
# │ ENVIRONMENT                        │ Yes      │ Next.js runtime         │
# │ BACKEND_URL                        │ Yes      │ BFF proxy (proxy.ts)    │
# │ PROXY_TIMEOUT_MS                   │ No       │ BFF proxy (proxy.ts)    │
# │ PROXY_SHORT_TIMEOUT_MS             │ No       │ BFF proxy (proxy.ts)    │
# │ JWT_SECRET                         │ Yes      │ middleware.ts            │
# │ SENTRY_DSN_FRONTEND                │ No       │ Next.js server runtime  │
# │ NEXT_PUBLIC_*                      │ No       │ Browser bundle          │
# └────────────────────────────────────┴──────────┴─────────────────────────┘

# === ENVIRONMENT ===

# [REQUIRED] Runtime environment label for frontend builds.
ENVIRONMENT=production

# === APP URLS & ROUTING ===

# [REQUIRED] Internal backend URL used by the Next.js BFF at runtime inside Docker.
BACKEND_URL=http://backend:8000

# [OPTIONAL] Proxy timeout for long-running frontend API routes in milliseconds.
PROXY_TIMEOUT_MS=90000

# [OPTIONAL] Proxy timeout for short frontend API routes in milliseconds.
PROXY_SHORT_TIMEOUT_MS=15000

# === AUTHENTICATION ===

# [REQUIRED] Shared secret for Next.js auth helpers and middleware.
JWT_SECRET=<YOUR_FRONTEND_JWT_SECRET>

# === OBSERVABILITY ===

# [OPTIONAL] Server-side Sentry DSN for Next.js node/edge runtime (SSR, RSC, route handlers).
SENTRY_DSN_FRONTEND=

# [OPTIONAL] Browser-visible toggle for Sentry in the frontend. Expected values: true or false.
NEXT_PUBLIC_SENTRY_ENABLED=false

# [OPTIONAL] Browser-visible Sentry DSN for frontend monitoring.
NEXT_PUBLIC_SENTRY_DSN=

# [OPTIONAL] Frontend Sentry environment tag.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# [OPTIONAL] Frontend Sentry release identifier.
NEXT_PUBLIC_SENTRY_RELEASE=

# [OPTIONAL] Frontend trace sampling rate. Expected format: decimal between 0 and 1.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2

# [OPTIONAL] Frontend replay session sampling rate. Expected format: decimal between 0 and 1.
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.05

# [OPTIONAL] Frontend replay-on-error sampling rate. Expected format: decimal between 0 and 1.
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# === FRONTEND PUBLIC ===

# [REQUIRED] Browser-visible canonical app URL used by the frontend.
NEXT_PUBLIC_APP_URL=https://thothgraph.com

# [OPTIONAL] Browser-visible backend public URL used for OAuth and direct navigations.
NEXT_PUBLIC_BACKEND_PUBLIC_URL=https://api.thothgraph.com

# [OPTIONAL] Browser-visible API base URL. Use a same-origin path in production.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# [OPTIONAL] Browser-visible support/contact email.
NEXT_PUBLIC_CONTACT_EMAIL=support@qiko.ai

# [OPTIONAL] Browser-visible contact webmail target. Expected values: gmail or outlook.
NEXT_PUBLIC_CONTACT_WEBMAIL_PROVIDER=gmail

# [OPTIONAL] Browser-visible support email.
NEXT_PUBLIC_SUPPORT_EMAIL=support@qiko.ai

# [OPTIONAL] Browser-visible billing email.
NEXT_PUBLIC_BILLING_EMAIL=billing@qiko.ai

# [OPTIONAL] Browser-visible privacy email.
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@qiko.ai

# === ANALYTICS & WEBMASTER VERIFICATION ===

# [OPTIONAL] Google Tag Manager container ID (e.g. GTM-XXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GTM_ID=

# [OPTIONAL] GA4 Measurement ID (e.g. G-XXXXXXXXXX). Loaded via GTM, not standalone.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# [OPTIONAL] Google Search Console HTML meta tag verification code.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# [OPTIONAL] Bing Webmaster Tools HTML meta tag verification code.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# [OPTIONAL] Serve the whole app under a sub-path (e.g. /signal on qiko.ai).
# Default (empty) keeps root-domain hosting unchanged; coexists with the
# host-based tenant resolver (white-label custom domains).
NEXT_PUBLIC_BASE_PATH=

# [OPTIONAL] Static asset prefix; normally set to the same value as
# NEXT_PUBLIC_BASE_PATH (or a CDN origin).
NEXT_PUBLIC_ASSET_PREFIX=

# Enable the Arabic / RTL foundation (language switcher, `ar` locale offering,
# dir="rtl"). On by default - only the literal "false" disables it, so an unset
# value still offers Arabic. It is inlined at build time, so a change needs a
# rebuild, not a restart. SIGV2-1060.
NEXT_PUBLIC_ENABLE_RTL=true

# === MAILCHIMP WAITLIST (server-side, coming-soon gate page) ===
# The waitlist form on frontend/src/app/gate/page.tsx posts to the server-side
# route handler frontend/src/app/api/waitlist/route.ts, which calls the Mailchimp
# Marketing API. The API key is SERVER-ONLY — it must never be prefixed with
# NEXT_PUBLIC_ and never committed. Set it in the frontend container's real .env.
#
# [REQUIRED for waitlist] Mailchimp API key (format: <key>-<dc>, e.g. ...-us18).
MAILCHIMP_API_KEY=
# [OPTIONAL] Audience/List ID (defaults to the Signal coming-soon list).
MAILCHIMP_AUDIENCE_ID=4c688f64f2
# [OPTIONAL] Tag applied to every signup for filtering.
MAILCHIMP_TAG=signal-coming-soon
# [OPTIONAL] "subscribed" (single opt-in, default) or "pending" (double opt-in).
MAILCHIMP_STATUS_IF_NEW=subscribed
