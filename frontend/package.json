{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-with-env.mjs NEXT_DIST_DIR=.next-dev dev",
    "build": "node scripts/next-with-env.mjs build",
    "build:mock": "node scripts/next-with-env.mjs NEXT_PUBLIC_ENABLE_RTL=true NEXT_TELEMETRY_DISABLED=1 build",
    "start": "node scripts/next-with-env.mjs start",
    "dev:mock": "node scripts/dev-mock.mjs",
    "start:mock": "node scripts/preview-mock.mjs",
    "preview:mock": "node scripts/preview-mock.mjs --build",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node ./scripts/run-vitest.mjs",
    "test:unit": "node ./scripts/run-vitest.mjs",
    "test:wsl": "node ./scripts/run-vitest.mjs",
    "ui:pdf": "node scripts/generate-ui-standard-pdf.mjs",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test:e2e": "npx playwright test --project chromium --project desktop-firefox --project mobile-chrome --project mobile-safari",
    "test:e2e:visual": "bash e2e/visual/run-in-docker.sh",
    "test:e2e:visual:update": "bash e2e/visual/run-in-docker.sh --update-snapshots",
    "test:design-compare": "bash e2e/visual/compare-to-design.sh",
    "test:design-compare:update": "bash e2e/visual/compare-to-design.sh --update-reference",
    "test:design-compare:thresholds": "bash e2e/visual/compare-to-design.sh --write-thresholds",
    "test:design-compare:ci": "node e2e/design-comparison/compare.mjs --reference-only",
    "test:design-shard": "node --test e2e/design-comparison/*.test.mjs",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:report": "npx playwright show-report"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@scalar/api-reference-react": "^0.9.10",
    "@simplewebauthn/browser": "^13.2.2",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^9.2.4",
    "axios": "^1.13.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "html2canvas": "^1.4.1",
    "i18next": "^25.8.5",
    "jose": "^6.1.3",
    "jspdf": "^4.2.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^16.5.4",
    "react-markdown": "^9.0.1",
    "recharts": "^3.10.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/forms": "0.5.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "20.19.30",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "^8",
    "eslint-config-next": "15.5.12",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0",
    "postcss": "^8",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "rollup": "4.59.0",
    "vite": "7.3.6",
    "source-map-js": "1.2.2",
    "vue": "3.5.42",
    "eslint": {
      "ajv": "6.14.0",
      "js-yaml": "^4.3.2"
    },
    "@eslint/eslintrc": {
      "ajv": "6.14.0",
      "js-yaml": "^4.3.2"
    }
  }
}
