# Frontend Development Environment Template
#
# Only variables consumed by the Next.js frontend (BFF proxy, SSR, NEXT_PUBLIC_*).
# Backend/worker/infra variables live in the root .env.development.example.
# Copied to frontend/.env.local by scripts/setup-development.sh.

# === ENVIRONMENT ===

# [REQUIRED] Runtime environment label for frontend local development.
ENVIRONMENT=development

# === APP URLS & ROUTING ===

# [REQUIRED] Backend URL used by the Next.js BFF when running outside Docker.
BACKEND_URL=http://localhost:8000

# [OPTIONAL] Proxy timeout for long-running frontend API routes in milliseconds.
PROXY_TIMEOUT_MS=90000

# [OPTIONAL] Proxy timeout for short frontend API routes in milliseconds.
PROXY_SHORT_TIMEOUT_MS=15000

# === AUTHENTICATION ===

# [REQUIRED] Shared secret for Next.js auth helpers and middleware.
JWT_SECRET=dev_frontend_jwt_secret_change_me

# === OBSERVABILITY ===

# [OPTIONAL] Server-side Sentry DSN for Next.js node/edge runtime.
SENTRY_DSN_FRONTEND=

NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# === FRONTEND PUBLIC ===

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_PUBLIC_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_CONTACT_EMAIL=support@qiko.ai
NEXT_PUBLIC_CONTACT_WEBMAIL_PROVIDER=gmail
NEXT_PUBLIC_SUPPORT_EMAIL=support@qiko.ai
NEXT_PUBLIC_BILLING_EMAIL=billing@qiko.ai
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@qiko.ai
