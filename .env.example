# Production Environment Template — Root
#
# This is the canonical .env template for VPS/production deployments.
# Docker Compose loads this file for all backend, worker, and frontend services.
#
# Variable Contract — which containers consume which sections:
#
# ┌────────────────────────────────┬─────────────────────────────────────────────────────────┐
# │ Section                        │ Consumed by                                             │
# ├────────────────────────────────┼─────────────────────────────────────────────────────────┤
# │ ENVIRONMENT                    │ All services                                            │
# │ APP URLS & ROUTING             │ backend, frontend, caddy                                │
# │ DATABASE & CACHE               │ db, redis, backend, all workers                         │
# │ AUTHENTICATION & SESSION       │ backend, frontend (JWT_SECRET only)                     │
# │ AWS SSM (secret overlay)       │ backend, all workers, ai-service                        │
# │ CREDENTIAL ISOLATION           │ backend, all workers, ai-service                        │
# │ GOOGLE CLOUD STORAGE           │ backend, pdf-worker                                     │
# │ BILLING & STRIPE               │ backend, billing-webhook-worker                         │
# │ EMAIL & NOTIFICATIONS          │ backend, email-worker                                   │
# │ AI & EXTERNAL APIS             │ backend, ai-service, audit-worker                       │
# │ OAUTH & INTEGRATIONS           │ backend                                                 │
# │ WORKERS & QUEUES               │ backend, audit-worker, billing-webhook-worker            │
# │ OBSERVABILITY                  │ backend, frontend, all workers, ai-service               │
# │ FRONTEND PUBLIC (NEXT_PUBLIC_) │ frontend (baked into browser bundle at build time)       │
# │ ANALYTICS & WEBMASTER          │ frontend (baked into browser bundle at build time)       │
# └────────────────────────────────┴─────────────────────────────────────────────────────────┘
#
# Source priority: AWS SSM (runtime overlay) > this .env file > code defaults
# DB-backed config (admin UI) overrides env vars at runtime for ~80 operational keys.
# See docs/admin-configuration.md for the full list.

# === ENVIRONMENT ===

# [REQUIRED] Runtime environment for Docker Compose, backend settings, and secret resolution. Use "production" on VPS deployments.
ENVIRONMENT=production

# [REQUIRED] Public apex domain used by Caddy and application-generated links. Format: domain only, no protocol.
DOMAIN=thothgraph.com

# === APP URLS & ROUTING ===

# [REQUIRED] Canonical public app URL used in emails, billing redirects, and backend links. Format: https://host.
APP_BASE_URL=https://qiko.ai/signal

# [REQUIRED] Public browser URL for the Next.js frontend. Format: https://host.
FRONTEND_URL=https://qiko.ai/signal

# [REQUIRED] Public backend base URL for OAuth callbacks and API-origin links.
# Must match the domain Caddy serves (same as APP_BASE_URL when using path-based routing).
BACKEND_PUBLIC_URL=https://qiko.ai/signal

# [REQUIRED] Internal frontend-to-backend URL used by the Next.js BFF in Docker. Format: http://service:port.
BACKEND_URL=http://backend:8000

# [REQUIRED] Allowed browser origins for backend CORS. Format: comma-separated URLs.
# This allowlist is credentialed and applies to every endpoint, so keep it to
# origins that are allowed to act on behalf of a logged-in user.
CORS_ORIGINS=https://qiko.ai,https://qiko.ai/signal

# [OPTIONAL] Marketing-site origins allowed to read the public, unauthenticated
# endpoints cross-origin: GET /api/v1/billing/plans/public and the queued guest
# audit under /api/v1/public/. Format: comma-separated URLs, no wildcard. This
# is NOT the CORS allowlist above: it grants no credentials and applies to
# those public endpoints only.
# Preprod: the site is a different origin from Signal, so set
#   PUBLIC_SITE_ORIGINS=https://www.preprod.qiko.ai
# Live: the site is path-shared on https://qiko.ai, which is the same origin as
# the API, so leave this empty.
PUBLIC_SITE_ORIGINS=

# [OPTIONAL] Allowed hostnames accepted by backend host validation. Format: comma-separated hostnames.
ALLOWED_HOSTS=thothgraph.com,www.thothgraph.com,backend,localhost

# [REQUIRED to enable custom domains] Approved DNS target agencies should use for
# workspace custom-domain CNAME records. Supplied by the release owner per environment;
# when unset or invalid the feature is unavailable rather than serving a guessed host.
CUSTOM_DOMAIN_CNAME_TARGET=

# [OPTIONAL] Whether DNS-verified custom domains should become TLS-eligible immediately.
CUSTOM_DOMAIN_AUTO_ACTIVATE_ON_VERIFY=true

# [OPTIONAL] Additional platform-controlled hosts that must never resolve as tenant domains.
CUSTOM_DOMAIN_SYSTEM_HOSTS=

# [OPTIONAL] Cloudflare API token used to create and manage SaaS custom hostnames.
CLOUDFLARE_API_TOKEN=

# NOTE: Runtime-editable settings such as AI provider keys, model routing, email
# delivery settings, OAuth clients, Cloudflare custom-domain credentials, CORS/
# host allowlists, GA4 path, GCS bucket/prefix, and billing feature toggles are
# now DB-backed. Keep them in AWS SSM for bootstrap/reseed, but treat the database
# as the runtime source of truth after the first successful boot.

# [OPTIONAL] Cloudflare zone ID for the platform domain.
CLOUDFLARE_ZONE_ID=

# [OPTIONAL] Cloudflare API base URL.
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4

# [OPTIONAL] Validation method used when creating Cloudflare custom hostnames.
CLOUDFLARE_CUSTOM_HOSTNAME_VALIDATION_METHOD=http

# [OPTIONAL] Override origin hostname for Cloudflare custom hostnames. Leave blank to use the zone fallback origin.
CLOUDFLARE_CUSTOM_ORIGIN_SERVER=

# [OPTIONAL] Backend and worker log verbosity. Expected values: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# [OPTIONAL] Proxy timeout for long-running frontend API routes in milliseconds.
PROXY_TIMEOUT_MS=90000

# [OPTIONAL] Proxy timeout for short frontend API routes in milliseconds.
PROXY_SHORT_TIMEOUT_MS=15000

# === DATABASE & CACHE ===

# [REQUIRED] PostgreSQL username used by the Compose database container.
POSTGRES_USER=user

# [REQUIRED] PostgreSQL password used by the Compose database container. Source: AWS SSM secret in production.
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>

# [REQUIRED] PostgreSQL database name used by the Compose database container.
POSTGRES_DB=dbname

# [REQUIRED] Backend SQLAlchemy connection string. Format: postgresql://user:password@host:port/dbname.
DATABASE_URL=postgresql://user:<YOUR_POSTGRES_PASSWORD>@db:5432/dbname

# [REQUIRED] Redis connection string for cache, queues, and rate limiting.
# Local dev: redis://redis:6379  (no auth needed)
# Production: redis://:YOUR_STRONG_PASSWORD@redis:6379  (auth required)
# Production TLS: rediss://:YOUR_STRONG_PASSWORD@redis:6380  (auth + TLS)
REDIS_URL=redis://redis:6379

# [OPTIONAL] Redis password used by docker-compose to start redis-server with --requirepass.
# When set, embed the same password in REDIS_URL above as redis://:PASSWORD@redis:6379.
REDIS_PASSWORD=

# [REQUIRED] Internal URL for the dedicated AI service. Format: http://service:port.
AI_SERVICE_URL=http://ai-service:8001

# [OPTIONAL] Toggle for running database migrations during backend startup. Expected values: 1 or 0.
RUN_MIGRATIONS=1

# === AUTHENTICATION & SESSION ===

# [REQUIRED] Shared secret for Next.js auth helpers and middleware. Source: generated secret or AWS SSM.
JWT_SECRET=<YOUR_FRONTEND_JWT_SECRET>

# [REQUIRED] Backend access-token signing secret. Source: strong random value or AWS SSM.
JWT_SECRET_KEY=<YOUR_BACKEND_JWT_SECRET>

# [REQUIRED] Backend refresh-token signing secret. Source: strong random value or AWS SSM.
JWT_REFRESH_SECRET_KEY=<YOUR_BACKEND_REFRESH_SECRET>

# [REQUIRED] Session encryption/signing secret used by backend session features. Source: strong random value or AWS SSM.
SESSION_SECRET_KEY=<YOUR_SESSION_SECRET>

# [OPTIONAL] JWT signing algorithm used by backend auth.
JWT_ALGORITHM=HS256

# [OPTIONAL] Access-token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# [OPTIONAL] Refresh-token lifetime in days.
REFRESH_TOKEN_EXPIRE_DAYS=7

# [OPTIONAL] "Remember me" access-token lifetime in minutes.
REMEMBER_ME_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# [OPTIONAL] "Remember me" refresh-token lifetime in days.
REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=30

# [OPTIONAL] Email verification token lifetime in hours.
EMAIL_TOKEN_EXPIRE_HOURS=48

# [OPTIONAL] Password reset token lifetime in hours.
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24

# [OPTIONAL] Public audit share-link lifetime in days, from the moment the token
# is minted. Links issued before this setting existed have no recorded expiry
# and keep working until they are rotated.
AUDIT_SHARE_TOKEN_TTL_DAYS=30

# [OPTIONAL] Whether email verification is required before full account activation. Expected values: true or false.
EMAIL_VERIFICATION_REQUIRED=true

# [OPTIONAL] Time-based setup token lifetime for MFA enrollment in seconds.
MFA_SETUP_TOKEN_EXPIRE_SECONDS=900

# [OPTIONAL] Issuer label shown inside authenticator apps.
MFA_ISSUER=Qiko Signal

# [OPTIONAL] Additional encryption key for stored OAuth tokens. Source: strong random value or AWS SSM.
OAUTH_TOKEN_ENCRYPTION_KEY=<YOUR_OAUTH_TOKEN_ENCRYPTION_KEY>

# [OPTIONAL] Bootstrap admin users. Format: comma-separated email addresses.
ADMIN_EMAILS=

# [OPTIONAL] Restrict registration and all login flows to these emails during the current stage.
AUTH_ALLOWED_EMAILS=razvan240486@gmail.com,babarazvan@yahoo.com,razvan.baba@icloud.com

# === AWS SSM (deployed secret overlay) ===

# Local dev uses these .env files directly. Deployed environments overlay AWS SSM
# Parameter Store at startup (backend/core/env_bootstrap.py). If AWS is unreachable
# the overlay is skipped and the dotenv/env values below are used as-is.

# [OPTIONAL] Enable the AWS SSM overlay. Set false for pure local/dotenv.
# SSM_ENABLED=true

# [OPTIONAL] Parameter name prefix for application secrets in SSM Parameter Store.
# SSM_PARAM_PREFIX=/thothgraph/

# [OPTIONAL] Whether SSM values overwrite already-populated env vars.
# SSM_OVERRIDE=true

# [OPTIONAL] AWS region hosting the SSM parameters.
# AWS_REGION=eu-central-1

# === CREDENTIAL ISOLATION (SEC-10) ===

# [OPTIONAL] Per-service credential role for per-service credential filtering.
# Set automatically in docker-compose.yml; override here only if running services outside Compose.
# Valid roles: api_server, audit_worker, email_worker, pdf_worker, ai_service,
#              monitoring_worker, visibility_worker, performance_worker, cron_sweeper, external_webhook_worker.
SERVICE_CREDENTIAL_ROLE=

# [OPTIONAL] When true, SA email pattern mismatches are fatal at startup. Default: false (warn only).
CREDENTIAL_BOUNDARY_ENFORCE=false

# [OPTIONAL] Per-role GCP SA file paths for production credential isolation.
# When set, each service uses its own SA instead of the shared ADC file.
# See scripts/create-per-role-credentials.sh for provisioning.
GCP_CREDENTIALS_API=
GCP_CREDENTIALS_WORKER=
GCP_CREDENTIALS_STORAGE=
GCP_CREDENTIALS_AI=

# === GOOGLE CLOUD STORAGE ===

# [OPTIONAL] GCS bucket name for report/logo assets. Leave blank to keep local filesystem fallback.
GCS_BUCKET_NAME=

# [OPTIONAL] Object prefix for generated report PDFs.
GCS_REPORTS_PREFIX=reports/

# [OPTIONAL] Object prefix for uploaded branding logos.
GCS_LOGOS_PREFIX=logos/

# [OPTIONAL] Default report retention period in days (valid operational values: 30, 60, 90).
GCS_REPORT_RETENTION_DAYS=30

# [OPTIONAL] Signed download URL lifetime for report PDFs.
GCS_SIGNED_URL_EXPIRY_MINUTES=60

# [OPTIONAL] Local fallback storage root (must be shared between backend and pdf-worker when GCS is disabled).
LOCAL_STORAGE_ROOT=

# === BILLING & STRIPE ===

# Production keeps direct Stripe webhook verification with the configured
# webhook secret. Do not use Stripe CLI in production.

# [REQUIRED] Active Stripe operating mode. Expected values: test or live.
STRIPE_MODE=live

# [OPTIONAL] Stripe test secret key. Source: Stripe dashboard or AWS SSM.
STRIPE_SECRET_KEY_TEST=

# [OPTIONAL] Stripe live secret key. Source: Stripe dashboard or AWS SSM.
STRIPE_SECRET_KEY_LIVE=<YOUR_STRIPE_SECRET_KEY>

# [OPTIONAL] Stripe test webhook signing secret.
STRIPE_WEBHOOK_SECRET_TEST=

# [OPTIONAL] Stripe live webhook signing secret. Source: Stripe dashboard or AWS SSM.
STRIPE_WEBHOOK_SECRET_LIVE=<YOUR_STRIPE_WEBHOOK_SECRET>

# [OPTIONAL] Canonical plan price env fallbacks used only when admin runtime catalog sync has not populated billing_runtime.
STRIPE_PRICE_STANDARD=<YOUR_STRIPE_PRICE_STANDARD>
STRIPE_PRICE_SPECIALIST=<YOUR_STRIPE_PRICE_SPECIALIST>
STRIPE_PRICE_EXECUTIVE=<YOUR_STRIPE_PRICE_EXECUTIVE>

# [OPTIONAL] Mode-specific plan price env fallbacks used when no runtime override exists for the requested Stripe mode.
STRIPE_PRICE_STANDARD_TEST=
STRIPE_PRICE_STANDARD_LIVE=<YOUR_STRIPE_PRICE_STANDARD>
STRIPE_PRICE_SPECIALIST_TEST=
STRIPE_PRICE_SPECIALIST_LIVE=<YOUR_STRIPE_PRICE_SPECIALIST>
STRIPE_PRICE_EXECUTIVE_TEST=
STRIPE_PRICE_EXECUTIVE_LIVE=<YOUR_STRIPE_PRICE_EXECUTIVE>

# [OPTIONAL] Mode-specific annual plan price env fallbacks, same role as the monthly ones above.
# The admin catalog sync manages these prices too, so a value here is only a fallback.
STRIPE_PRICE_STANDARD_ANNUAL_TEST=
STRIPE_PRICE_STANDARD_ANNUAL_LIVE=<YOUR_STRIPE_PRICE_STANDARD_ANNUAL>
STRIPE_PRICE_SPECIALIST_ANNUAL_TEST=
STRIPE_PRICE_SPECIALIST_ANNUAL_LIVE=<YOUR_STRIPE_PRICE_SPECIALIST_ANNUAL>
STRIPE_PRICE_EXECUTIVE_ANNUAL_TEST=
STRIPE_PRICE_EXECUTIVE_ANNUAL_LIVE=<YOUR_STRIPE_PRICE_EXECUTIVE_ANNUAL>

# [OPTIONAL] Commitment Stripe price env fallbacks for the fixed monthly tiers.
STRIPE_PRICE_COMMITMENT_GROWTH_TEST=
STRIPE_PRICE_COMMITMENT_GROWTH_LIVE=<YOUR_STRIPE_PRICE_COMMITMENT_GROWTH>
STRIPE_PRICE_COMMITMENT_SCALE_TEST=
STRIPE_PRICE_COMMITMENT_SCALE_LIVE=<YOUR_STRIPE_PRICE_COMMITMENT_SCALE>
STRIPE_PRICE_COMMITMENT_ENTERPRISE_TEST=
STRIPE_PRICE_COMMITMENT_ENTERPRISE_LIVE=<YOUR_STRIPE_PRICE_COMMITMENT_ENTERPRISE>

# [OPTIONAL] Stripe metered overage price used by all commitment subscriptions.
STRIPE_PRICE_COMMITMENT_OVERAGE_TEST=
STRIPE_PRICE_COMMITMENT_OVERAGE_LIVE=<YOUR_STRIPE_PRICE_COMMITMENT_OVERAGE>

# [OPTIONAL] Feature flag controlling whether billing flows are active. Expected values: true or false.
FEATURE_BILLING_ENABLED=true

# [OPTIONAL] Feature flag enabling post-failure grace periods. Expected values: true or false.
FEATURE_BILLING_GRACE_PERIOD=true

# [OPTIONAL] Number of days a subscription can remain in grace period after failed payment.
BILLING_GRACE_PERIOD_DAYS=7

# === EMAIL & NOTIFICATIONS ===

# [OPTIONAL] Master toggle for transactional email sending. Expected values: true or false.
MAIL_ENABLED=true

# [OPTIONAL] Provider slug for outbound email delivery. Expected values: breevo, smtp, api.
EMAIL_PROVIDER=breevo

# [REQUIRED] Verified sender email used in transactional emails.
EMAIL_FROM_ADDRESS=support@qiko.ai

# [REQUIRED] Human-readable sender name shown in inboxes.
EMAIL_FROM_NAME=Qiko Signal Intelligence Analyzer



# [OPTIONAL] SMTP host used when EMAIL_PROVIDER=smtp.
SMTP_HOST=

# [OPTIONAL] SMTP port used when EMAIL_PROVIDER=smtp.
SMTP_PORT=587

# [OPTIONAL] SMTP username used when EMAIL_PROVIDER=smtp.
SMTP_USERNAME=

# [OPTIONAL] SMTP password used when EMAIL_PROVIDER=smtp. Source: provider secret or AWS SSM.
SMTP_PASSWORD=

# [OPTIONAL] Number of attempts before an email outbox item is marked failed.
EMAIL_OUTBOX_MAX_ATTEMPTS=5

# [OPTIONAL] Idle poll interval for the email outbox worker in seconds.
EMAIL_OUTBOX_POLL_INTERVAL_SECONDS=15

# [OPTIONAL] Active poll interval for the email outbox worker in seconds when work is available.
EMAIL_OUTBOX_ACTIVE_POLL_INTERVAL_SECONDS=2

# [OPTIONAL] Maximum number of emails claimed from the outbox per polling batch.
EMAIL_OUTBOX_BATCH_SIZE=25

# [REQUIRED] Primary support contact shown across the app and emails.
SUPPORT_EMAIL=support@qiko.ai

# [REQUIRED] Billing contact shown across billing screens and receipts.
BILLING_EMAIL=billing@qiko.ai

# [REQUIRED] Privacy contact shown in legal and privacy surfaces.
PRIVACY_EMAIL=privacy@qiko.ai

# [OPTIONAL] Default inbox for site contact form submissions.
CONTACT_INBOX_ADDRESS=support@qiko.ai

# [OPTIONAL] Ticket prefix used when generating contact or support reference IDs.
CONTACT_TICKET_PREFIX=STX

# === AI & EXTERNAL APIS ===

# [OPTIONAL] Primary Gemini API key for Google GenAI features. Source: Google AI Studio or AWS SSM.
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# [OPTIONAL] OpenAI API key used for supported OpenAI provider calls.
OPENAI_API_KEY=

# [OPTIONAL] Anthropic API key used for supported Anthropic provider calls.
ANTHROPIC_API_KEY=

# --- AWS Bedrock (OPT-IN reasoning provider; never default routing) ---
# [OPTIONAL] Set to true to construct the Bedrock client and make the
# "bedrock" provider selectable. Defaults to false (zero behaviour change).
BEDROCK_ENABLED=false
# [OPTIONAL] AWS region for the bedrock-runtime client.
BEDROCK_REGION=us-east-1
# [OPTIONAL] Amazon Nova model ids per execution tier.
BEDROCK_LITE_MODEL=amazon.nova-micro-v1:0
BEDROCK_FAST_MODEL=amazon.nova-lite-v1:0
BEDROCK_SMART_MODEL=amazon.nova-pro-v1:0
# [OPTIONAL] When true (and BEDROCK_ENABLED), every reasoning/debate route
# (audit + debate/team + pre-scan/site-classify) resolves to the Bedrock
# provider. Defaults to false (zero behaviour change; current providers used).
BEDROCK_ONLY_REASONING=false
# [OPTIONAL] When true (and BEDROCK_ENABLED), every visibility (measurement-
# target) run queries Bedrock models instead of the external engines.
# Defaults to false (zero behaviour change; current external APIs used).
BEDROCK_ONLY_MEASUREMENT=false
# [OPTIONAL] JSON map overriding the per-provider Bedrock model ids used when
# BEDROCK_ONLY_MEASUREMENT is true. Defaults are set in core/config.py, e.g.:
# BEDROCK_MEASUREMENT_MODEL_MAP={"openai":"openai.gpt-oss-120b-1:0","google":"qwen.qwen3-235b-a22b-2507-v1:0"}
# --- OpenRouter live-engine measurement (Phase 11; OPT-IN; paid add-on) ---
# [OPTIONAL][SECRET] OpenRouter API key. Provisioned by a human into AWS SSM
# (/thothgraph/) + local .env. NEVER commit a value here; NEVER log it.
OPENROUTER_API_KEY=
# [OPTIONAL] OpenRouter API base URL. Defaults set in core/config.py.
OPENROUTER_BASE_URL=
# [OPTIONAL] When true, visibility (measurement-target) runs route to the REAL
# consumer engines via OpenRouter instead of the controlled Bedrock panel.
# Defaults to false (zero behaviour change; reasoning ALWAYS stays on Bedrock).
LIVE_ENGINE_MEASUREMENT_ENABLED=false
# [OPTIONAL] JSON map overriding the per-engine OpenRouter model ids used when
# LIVE_ENGINE_MEASUREMENT_ENABLED is true. Defaults are set in core/config.py.
# Bing has no entry — no public consumer API to measure live.
# OPENROUTER_MEASUREMENT_MODEL_MAP={"openai":"openai/gpt-5","google":"google/gemini-2.5-pro"}
# [OPTIONAL] When true, each live measurement requests the OpenRouter
# `openrouter:web_search` server tool so answers are grounded in today's web
# (search fees land in usage.cost on top of tokens). Defaults to true since
# SIGV2-1188: the per-plan prompt caps, engine rosters and sweep cadences in
# VISIBILITY_PLAN_LIMITS are what bound that spend per plan.
OPENROUTER_WEB_SEARCH_ENABLED=true
# [OPTIONAL] Per-plan scheduled-sweep cadence overrides in seconds (SIGV2-1188).
# The defaults live in VISIBILITY_PLAN_LIMITS (Starter weekly, Specialist every
# two days since SIGV2-1216, everything else daily); these let cadence move
# without a deploy. An unset, unparseable or non-positive value falls back to
# the plan's default and is logged once.
#
# The values below are the committed defaults, written out so a fresh
# environment reads the same as the table. Cadence is the dial that keeps a
# plan's measurement cost inside its price, so it must never depend on someone
# remembering to set a variable: setting one of these is how you move a plan
# ahead of a deploy, not how you make the ladder correct.
# VISIBILITY_STARTER_SWEEP_SECONDS=604800
# VISIBILITY_AGENCY_TRIAL_SWEEP_SECONDS=86400
# VISIBILITY_STANDARD_SWEEP_SECONDS=86400
# VISIBILITY_SPECIALIST_SWEEP_SECONDS=172800
# VISIBILITY_EXECUTIVE_SWEEP_SECONDS=86400
# [OPTIONAL] Per-plan cadence overrides for the SCHEDULED COMPETITOR sweep in
# seconds (SIGV2-1208). Competitor domains re-measure on their own, slower
# clock than the project's own domain, because the cost scales with the number
# of competitors tracked. Defaults are weekly on the plans that include
# competitor analysis (Agency Trial, Specialist, Executive) and off on the
# plans that do not (Starter, Standard), where competitor cells stay on-demand
# only. These are cost dials, not entitlement switches: a value set for a plan
# without competitor analysis is ignored, and an unparseable or non-positive
# value falls back to the plan's default and is logged once.
# VISIBILITY_AGENCY_TRIAL_COMPETITOR_SWEEP_SECONDS=604800
# VISIBILITY_SPECIALIST_COMPETITOR_SWEEP_SECONDS=604800
# VISIBILITY_EXECUTIVE_COMPETITOR_SWEEP_SECONDS=604800
# Master switch for AI-generated CMS content (blog articles + case studies).
# Defaults true (current behaviour). Set false to retire AI content generation.
CMS_AI_GENERATION_ENABLED=true
# [OPTIONAL][SECRET] Bedrock bearer token, read by boto3 directly from env.
# Leave empty to use standard AWS credentials instead.
AWS_BEARER_TOKEN_BEDROCK=

# [OPTIONAL] Firecrawl API key used for crawling and extraction.
FIRECRAWL_API_KEY=<YOUR_FIRECRAWL_API_KEY>

# [OPTIONAL] Google PageSpeed Insights API key.
PAGESPEED_API_KEY=<YOUR_PAGESPEED_API_KEY>

# [OPTIONAL] Generic search API key for SERP or search-provider integrations.
SEARCH_API_KEY=

# [OPTIONAL] Generic search API URL when using a custom search provider.
SEARCH_API_URL=

# [OPTIONAL] SerpAPI key for search result collection.
SERPAPI_API_KEY=

# [OPTIONAL] SerpAPI base URL.
SERPAPI_URL=https://serpapi.com/search.json

# [OPTIONAL] Search engine identifier sent to SerpAPI.
SERPAPI_ENGINE=google

# [OPTIONAL] Dedicated Google Places API key when separated from Gemini usage.
GOOGLE_PLACES_API_KEY=

# [OPTIONAL] Dedicated Google Maps API key when separated from Places usage.
GOOGLE_MAPS_API_KEY=

# [OPTIONAL] Google Places API mode. Expected values: new or legacy.
GOOGLE_PLACES_API_MODE=new

# [OPTIONAL] Whether to fall back from the new Places API to legacy endpoints. Expected values: true or false.
GOOGLE_PLACES_FALLBACK_TO_LEGACY=true

# [OPTIONAL] Google Places v1 text search endpoint.
GOOGLE_PLACES_NEW_TEXTSEARCH_URL=https://places.googleapis.com/v1/places:searchText

# [OPTIONAL] Google Places field mask used for new API requests.
GOOGLE_PLACES_NEW_FIELD_MASK=places.displayName,places.name

# [OPTIONAL] Enable multi-agent debate pipeline for smart-tier audits. Expected values: true or false.
DEBATE_ENABLED=true

# [OPTIONAL] Maximum EUR cost allowed for a single debate run before aborting.
DEBATE_COST_CAP_EUR=0.25

# [OPTIONAL] Maximum USD cost allowed for a single debate run before aborting.
DEBATE_COST_CAP_USD=0.25

# [OPTIONAL] FAST debate total timeout in seconds.
DEBATE_TOTAL_TIMEOUT_FAST_S=60

# [OPTIONAL] FAST debate per-step timeout in seconds.
DEBATE_STEP_TIMEOUT_FAST_S=15

# [OPTIONAL] FAST debate hard cost cap in EUR.
DEBATE_COST_CAP_FAST_EUR=0.50

# [OPTIONAL] SMART debate total timeout in seconds.
DEBATE_TOTAL_TIMEOUT_SMART_S=300

# [OPTIONAL] SMART debate per-step timeout in seconds.
DEBATE_STEP_TIMEOUT_SMART_S=60

# [OPTIONAL] SMART debate hard cost cap in EUR.
DEBATE_COST_CAP_SMART_EUR=5.00

# [OPTIONAL] DEEP_JUDGMENT debate total timeout in seconds.
DEBATE_TOTAL_TIMEOUT_DEEP_S=600

# [OPTIONAL] DEEP_JUDGMENT debate per-step timeout in seconds.
DEBATE_STEP_TIMEOUT_DEEP_S=90

# [OPTIONAL] DEEP_JUDGMENT debate hard cost cap in EUR.
DEBATE_COST_CAP_DEEP_EUR=20.00

# [OPTIONAL] Anthropic prompt-guard budgets for V3 inter-agent payloads.
ANTHROPIC_MAX_TRANSFER_PACKET_CHARS=8000
ANTHROPIC_MAX_CRITIQUE_PACKET_CHARS=6000
ANTHROPIC_MAX_CONSOLIDATED_PACKET_CHARS=12000
ANTHROPIC_MAX_AUDIT_DATA_CHARS=10000

# [DANGEROUS][OPTIONAL] Must stay false until TASK-90 moat ingestion is deployed. Enables live FAST V3 debate execution.
ORCHESTRA_V3_MOAT_READY=false

# [OPTIONAL] Claim Ledger — compact inter-agent transfer tuning.
# DEBATE_CLAIM_LEDGER_MAX_ITEMS=12
# CLAIM_LEDGER_PRIORITY_RECOMMENDATION=320
# CLAIM_LEDGER_PRIORITY_FINDING=280
# CLAIM_LEDGER_PRIORITY_SUMMARY=160
# CLAIM_LEDGER_PRIORITY_AEO_SIGNAL=240
# CLAIM_LEDGER_SEVERITY_CRITICAL=0.92
# CLAIM_LEDGER_SEVERITY_WARNING=0.78
# CLAIM_LEDGER_SEVERITY_INFO=0.64
# CLAIM_LEDGER_SUMMARY_CONFIDENCE_FALLBACK=0.72
# CLAIM_LEDGER_SUMMARY_CONFIDENCE_MIN=0.45
# CLAIM_LEDGER_MAX_TEXT_CHARS=220
# CLAIM_LEDGER_MAX_REFS=3

# [OPTIONAL] Default fast/cheap Google model identifier.
GOOGLE_FAST_MODEL=gemini-3.5-flash

# [OPTIONAL] Default high-quality Google model identifier.
GOOGLE_SMART_MODEL=gemini-3.5-flash

# [OPTIONAL] Default lightweight Google model identifier.
GOOGLE_LITE_MODEL=gemini-3.1-flash-lite

# [OPTIONAL] Google model used for CMS article generation.
CMS_GEMINI_TEXT_MODEL=gemini-3.5-flash

# [OPTIONAL] Explicit Google model used for CMS image generation. Leave blank to resolve from the tier setting.
CMS_GEMINI_IMAGE_MODEL=

# [OPTIONAL] CMS image model tier. Expected values: flash or pro.
CMS_GEMINI_IMAGE_TIER=flash

# [OPTIONAL] Concrete Gemini image model used when the CMS image tier is flash.
CMS_GEMINI_FLASH_IMAGE_MODEL=gemini-2.5-flash-image

# [OPTIONAL] Concrete Gemini image model used when the CMS image tier is pro.
CMS_GEMINI_PRO_IMAGE_MODEL=gemini-3-pro-image-preview

# [OPTIONAL] Google model used for support and assistant chat features.
SUPPORT_CHAT_MODEL=gemini-2.5-flash

# [OPTIONAL] OpenAI chat-completions base URL.
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# [OPTIONAL] Default lightweight OpenAI model identifier.
OPENAI_LITE_MODEL=gpt-5-nano

# [OPTIONAL] Default fast OpenAI model identifier.
OPENAI_FAST_MODEL=gpt-5-mini

# [OPTIONAL] Default high-quality OpenAI model identifier.
OPENAI_SMART_MODEL=gpt-5.4

# [OPTIONAL] Default lightweight Anthropic model identifier.
ANTHROPIC_LITE_MODEL=claude-haiku-4-5

# [OPTIONAL] Default fast Anthropic model identifier.
ANTHROPIC_FAST_MODEL=claude-sonnet-4-6

# [OPTIONAL] Default high-quality Anthropic model identifier.
ANTHROPIC_SMART_MODEL=claude-opus-4-6

# [OPTIONAL] DataForSEO login for SEO integrations.
DATAFORSEO_LOGIN=

# [OPTIONAL] DataForSEO password for SEO integrations.
DATAFORSEO_PASSWORD=

# [OPTIONAL] Path to a GA4 service account JSON file when analytics import is enabled.
GA4_SERVICE_ACCOUNT_JSON_PATH=

# [OPTIONAL] Firecrawl retry attempt count for transient crawl failures.
FIRECRAWL_RETRY_COUNT=3

# [OPTIONAL] Firecrawl retry base delay in seconds.
FIRECRAWL_RETRY_BASE_DELAY=0.5

# [OPTIONAL] Firecrawl retry maximum delay in seconds.
FIRECRAWL_RETRY_MAX_DELAY=4.0

# [OPTIONAL] PageSpeed retry attempt count for transient failures.
PAGESPEED_RETRY_COUNT=3

# [OPTIONAL] PageSpeed retry base delay in seconds.
PAGESPEED_RETRY_BASE_DELAY=0.5

# [OPTIONAL] PageSpeed retry maximum delay in seconds.
PAGESPEED_RETRY_MAX_DELAY=4.0

# [OPTIONAL] Global AI retry attempt count used by the AI service.
AI_RETRY_COUNT=3

# [OPTIONAL] Global AI retry base delay in seconds.
AI_RETRY_BASE_DELAY=0.5

# [OPTIONAL] Global AI retry maximum delay in seconds.
AI_RETRY_MAX_DELAY=4.0

# [OPTIONAL] Provider-specific Google retry override for the AI service.
AI_RETRY_COUNT_GOOGLE=3

# [OPTIONAL] Provider-specific OpenAI retry override for the AI service.
AI_RETRY_COUNT_OPENAI=3

# [OPTIONAL] Provider-specific Anthropic retry override for the AI service.
AI_RETRY_COUNT_ANTHROPIC=3

# === OAUTH & INTEGRATIONS ===

# [OPTIONAL] Google OAuth client ID for account linking or login flows.
GOOGLE_CLIENT_ID=

# [OPTIONAL] Google OAuth client secret for account linking or login flows.
GOOGLE_CLIENT_SECRET=

# [OPTIONAL] GitHub OAuth client ID.
GITHUB_CLIENT_ID=

# [OPTIONAL] GitHub OAuth client secret.
GITHUB_CLIENT_SECRET=

# [OPTIONAL] LinkedIn OAuth client ID.
LINKEDIN_CLIENT_ID=

# [OPTIONAL] LinkedIn OAuth client secret.
LINKEDIN_CLIENT_SECRET=

# [OPTIONAL] LinkedIn OAuth redirect URI. Format: full HTTPS URL.
LINKEDIN_REDIRECT_URI=https://thothgraph.com/api/v1/auth/linkedin/callback

# [OPTIONAL] Jira OAuth client ID.
JIRA_CLIENT_ID=

# [OPTIONAL] Jira OAuth client secret.
JIRA_CLIENT_SECRET=

# [OPTIONAL] Microsoft/Bing OAuth client ID.
BING_CLIENT_ID=

# [OPTIONAL] Microsoft/Bing OAuth client secret.
BING_CLIENT_SECRET=

# [OPTIONAL] Bing Webmaster API key for automated site provisioning in scripts/setup_analytics_production.py.
BING_WEBMASTER_API_KEY=

# [OPTIONAL] Microsoft tenant ID used for Bing OAuth apps. Use "common" for multi-tenant apps.
BING_TENANT_ID=common

# [OPTIONAL] OAuth scopes requested during Bing/Microsoft sign-in.
BING_OAUTH_SCOPE=openid profile email offline_access

# [OPTIONAL] Microsoft Entra ID (SSO) — separate app registration from Bing Webmaster.
# If unset, falls back to BING_CLIENT_ID / BING_CLIENT_SECRET (requires matching redirect URIs).
# Redirect URI to register in Azure: https://<your-domain>/api/v1/auth/microsoft/callback
MICROSOFT_SSO_CLIENT_ID=

# [OPTIONAL] Microsoft Entra ID (SSO) client secret.
MICROSOFT_SSO_CLIENT_SECRET=

# [OPTIONAL] Microsoft Entra ID tenant ID for SSO. Use "common" for multi-tenant apps.
MICROSOFT_SSO_TENANT_ID=common

# === WORKERS & QUEUES ===

# [OPTIONAL] Redis list name used for audit jobs.
AUDIT_QUEUE_NAME=audit_jobs

# [OPTIONAL] Redis key used for audit queue metrics.
AUDIT_QUEUE_METRICS_KEY=audit:metrics

# [OPTIONAL] Maximum number of attempts for a queued audit job.
AUDIT_JOB_MAX_ATTEMPTS=3

# [OPTIONAL] Delay in seconds before retrying a failed audit job.
AUDIT_JOB_RETRY_DELAY_SECONDS=2

# [OPTIONAL] Hard timeout for audit jobs in seconds.
AUDIT_JOB_TIMEOUT_SECONDS=900

# [OPTIONAL] Guest audit allowance per sliding window.
GUEST_AUDIT_LIMIT=1

# [OPTIONAL] Sliding window length for guest audits in seconds.
GUEST_AUDIT_WINDOW_SECONDS=86400

# [OPTIONAL] Failed login attempts allowed per client IP plus account before
# the pair is locked out (HTTP 429). Cleared by a successful login.
LOGIN_RATE_LIMIT=5
# [OPTIONAL] Window for the per IP+account login failure counter, seconds.
LOGIN_RATE_WINDOW=900
# [OPTIONAL] Failed login attempts allowed per client IP across all accounts
# (credential-spraying ceiling). Not cleared by a successful login.
LOGIN_IP_RATE_LIMIT=30
# [OPTIONAL] Window for the per-IP login failure counter, seconds.
LOGIN_IP_RATE_WINDOW=300

# [OPTIONAL] Per-IP rate limit for the unauthenticated public plan catalog
# endpoint. Format: <count>/<unit>, for example 60/min.
RATE_LIMIT_PLANS_PUBLIC=60/min

# [OPTIONAL] Per-IP submit limit for the queued public guest audit
# (POST /api/v1/public/guest-audit). Format: <count>/<unit>. Leave empty to
# reuse GUEST_AUDIT_LIMIT / GUEST_AUDIT_WINDOW_SECONDS above, so the public
# path inherits the same budget as the legacy synchronous endpoint.
RATE_LIMIT_GUEST_AUDIT_PUBLIC=

# [OPTIONAL] Redis list the queued public guest audits are pushed onto. The
# audit worker consumes it alongside the audit queues.
GUEST_AUDIT_QUEUE_NAME=guest_audit_jobs

# [OPTIONAL] How long a submitted guest audit job (and its result) stays
# readable, in seconds. After this the poll returns 404.
GUEST_AUDIT_JOB_TTL_SECONDS=1800

# [OPTIONAL] Hard ceiling on a single guest audit run, in seconds. A job still
# unfinished after this is reported to the caller as failed/timeout.
GUEST_AUDIT_JOB_TIMEOUT_SECONDS=300

# [OPTIONAL] Interval the API tells the marketing site to poll at, in ms.
GUEST_AUDIT_POLL_INTERVAL_MS=3000

# [OPTIONAL] Maximum number of guest audits waiting to start. A submission
# beyond this is refused with 503 instead of queueing more paid work.
GUEST_AUDIT_MAX_QUEUE_DEPTH=50

# [OPTIONAL] How many guest audits the worker runs at once.
GUEST_AUDIT_WORKER_CONCURRENCY=2

# [OPTIONAL] Window in which a repeat submission for the same target joins the
# job already running for it instead of paying for it twice. 0 disables it.
GUEST_AUDIT_TARGET_COOLDOWN_SECONDS=900

# [OPTIONAL] Queue name used for asynchronous Stripe webhook processing.
STRIPE_WEBHOOK_QUEUE_NAME=billing:webhook_events

# === OBSERVABILITY ===

# [OPTIONAL] Backend tracing provider. Expected values: none or sentry.
TRACING_BACKEND=none

# [OPTIONAL] Shared Sentry DSN fallback used by backend services.
SENTRY_DSN=

# [OPTIONAL] Sentry DSN override for the Next.js server/edge runtime.
SENTRY_DSN_FRONTEND=

# [OPTIONAL] Sentry DSN override for the main backend API.
SENTRY_DSN_AUDIT_API=

# [OPTIONAL] Sentry DSN override for the audit worker.
SENTRY_DSN_AUDIT_WORKER=

# [OPTIONAL] Sentry DSN override for the AI service.
SENTRY_DSN_AI_SERVICE=

# [OPTIONAL] Trace sampling rate for backend Sentry instrumentation. Expected format: decimal between 0 and 1.
SENTRY_TRACES_SAMPLE_RATE=0.2

# [OPTIONAL] Sentry environment tag.
SENTRY_ENVIRONMENT=production

# [OPTIONAL] Sentry release identifier.
SENTRY_RELEASE=

# === FRONTEND PUBLIC ===

# [OPTIONAL] Browser-visible app URL used by the frontend.
NEXT_PUBLIC_APP_URL=https://thothgraph.com

# [OPTIONAL] Browser-visible backend public URL used for OAuth and direct navigations.
NEXT_PUBLIC_BACKEND_PUBLIC_URL=https://api.thothgraph.com

# [OPTIONAL] Browser-visible API base URL. Use a same-origin path in production.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# [OPTIONAL] Browser-visible support/contact email.
NEXT_PUBLIC_CONTACT_EMAIL=support@qiko.ai

# [OPTIONAL] Browser-visible contact webmail target. Expected values: gmail or outlook.
NEXT_PUBLIC_CONTACT_WEBMAIL_PROVIDER=gmail

# [OPTIONAL] Base URL of the shared Qiko marketing site (qiko-website-v2), used to cross-link
# Home/Labs from Signal's own marketing header/footer. Defaults to https://qiko.ai if unset.
NEXT_PUBLIC_QIKO_SITE_URL=https://qiko.ai

# [OPTIONAL] Browser-visible support email.
NEXT_PUBLIC_SUPPORT_EMAIL=support@qiko.ai

# [OPTIONAL] Browser-visible billing email.
NEXT_PUBLIC_BILLING_EMAIL=billing@qiko.ai

# [OPTIONAL] Browser-visible privacy email.
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@qiko.ai

# [OPTIONAL] Browser-visible toggle for Sentry in the frontend. Expected values: true or false.
NEXT_PUBLIC_SENTRY_ENABLED=false

# [OPTIONAL] Browser-visible Sentry DSN for frontend monitoring.
NEXT_PUBLIC_SENTRY_DSN=

# [OPTIONAL] Frontend Sentry environment tag.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# [OPTIONAL] Frontend Sentry release identifier.
NEXT_PUBLIC_SENTRY_RELEASE=

# [OPTIONAL] Frontend trace sampling rate. Expected format: decimal between 0 and 1.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2

# [OPTIONAL] Frontend replay session sampling rate. Expected format: decimal between 0 and 1.
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.05

# [OPTIONAL] Frontend replay-on-error sampling rate. Expected format: decimal between 0 and 1.
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# === ANALYTICS & WEBMASTER VERIFICATION ===

# [OPTIONAL] Google Tag Manager container ID (e.g. GTM-XXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GTM_ID=

# [OPTIONAL] GA4 Measurement ID (e.g. G-XXXXXXXXXX). Loaded via GTM, not standalone.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# [OPTIONAL] Google Search Console HTML meta tag verification code.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# [OPTIONAL] Bing Webmaster Tools HTML meta tag verification code.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# [OPTIONAL] Private preview gate. When set, the whole Signal platform is locked
# behind this single shared password (cookie-based gate in Next.js middleware).
# Leave empty/unset to disable the gate (public launch).
SIGNAL_GATE_PASSWORD=
