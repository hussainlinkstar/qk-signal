/* ─── Table of Contents ─── */

.toc-page {
  break-before: page;
  page-break-before: always;
}

.toc-list {
  display: flex;
  flex-direction: column;
}

.toc-entry {
  display: flex;
  align-items: baseline;
  gap: 3mm;
  padding: 2.5mm 0;
}

.toc-num {
  flex: none;
  min-width: 7mm;
  font-size: 8pt;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--brand-primary);
}

.toc-desc {
  font-size: 9pt;
  color: var(--report-muted);
}

.toc-primary .toc-label {
  font-size: 10pt;
  font-weight: 600;
  color: var(--report-text);
}

.toc-secondary {
  padding-left: 6mm;
}

.toc-secondary .toc-label {
  font-size: 9pt;
  font-weight: 400;
  color: var(--report-muted);
}

.toc-dots {
  flex: 1;
  border-bottom: 1px dotted var(--report-border);
  min-width: 10mm;
}

/* ─── Rationale / dependencies in action items ─── */

.row-rationale {
  font-size: 8pt;
  color: var(--report-muted);
  font-style: italic;
  margin-top: 1mm;
}

.row-dependencies {
  font-size: 8pt;
  color: var(--report-muted);
  margin-top: 1mm;
}
