# Backend overlay template
#
# Use the root `.env.example` as the canonical production bootstrap template.
# This backend-specific file is intentionally minimal to avoid duplicating the
# same variables across root, backend, and frontend env files.
#
# Keep this file empty unless you need backend-only overrides that should not
# live in the shared root env file.

# Debate V3 cost/timeouts are documented in the root `.env.example` template:
# DEBATE_TOTAL_TIMEOUT_FAST_S, DEBATE_STEP_TIMEOUT_FAST_S, DEBATE_COST_CAP_FAST_EUR
# DEBATE_TOTAL_TIMEOUT_SMART_S, DEBATE_STEP_TIMEOUT_SMART_S, DEBATE_COST_CAP_SMART_EUR
# DEBATE_TOTAL_TIMEOUT_DEEP_S, DEBATE_STEP_TIMEOUT_DEEP_S, DEBATE_COST_CAP_DEEP_EUR

# Example backend-only override:
# RUN_MIGRATIONS=1

# Live-measurement web retrieval (SIGV2-1183). Default OFF: enabling it
# multiplies measurement cost and is gated on the per-plan caps in SIGV2-1188.
# OPENROUTER_WEB_SEARCH_ENABLED=false
