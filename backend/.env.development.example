# Backend local overlay template
#
# Use the root `.env.development.example` as the canonical local development
# template. This backend-specific overlay is intentionally minimal so local
# configuration stays in one place by default.
#
# Keep this file empty unless you need backend-only overrides while developing.

# Debate V3 cost/timeouts are documented in the root `.env.development.example`
# template to keep local configuration in one place:
# DEBATE_TOTAL_TIMEOUT_FAST_S, DEBATE_STEP_TIMEOUT_FAST_S, DEBATE_COST_CAP_FAST_EUR
# DEBATE_TOTAL_TIMEOUT_SMART_S, DEBATE_STEP_TIMEOUT_SMART_S, DEBATE_COST_CAP_SMART_EUR
# DEBATE_TOTAL_TIMEOUT_DEEP_S, DEBATE_STEP_TIMEOUT_DEEP_S, DEBATE_COST_CAP_DEEP_EUR

# Example backend-only override:
# RUN_MIGRATIONS=1
